{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/ai/workflow.md",
    "docs/ai/execution-protocol.md",
    "docs/ai/ai-file-standards.md",
    "docs/ai/approval-boundaries.md",
    "docs/ai/generated-artifacts.md",
    "docs/ai/adapter-contract.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "cat *": "ask",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "where *": "allow",
      "command -v *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "git tag *": "allow",
      "git config --get *": "allow",
      "git rev-parse *": "allow",
      "rg *": "ask",
      "fd *": "ask",
      "jq *": "allow",
      "yq *": "allow",
      "AI_OUTPUT=json bash scripts/ai/ai-search.sh *": "allow",
      "bash scripts/ai/ai-search.sh *": "allow",
      "AI_OUTPUT=json bash scripts/ai/preview-file.sh *": "allow",
      "bash scripts/ai/preview-file.sh *": "allow",
      "bash scripts/ai/query-usage.sh *": "allow",
      "bash scripts/ai/run-repo-tests.sh": "allow",
      "bash scripts/ai/run-repo-tests.sh *": "allow",
      "bash scripts/ai/ai-verify.sh *": "ask",
      "bash scripts/ai/ai-doc-check.sh --check *": "allow",
      "bash scripts/ai/repo-tool-inventory.sh": "allow",
      "bash scripts/ai/git-forensics.sh *": "allow",
      "bash scripts/ai/ai-diff-context.sh *": "allow",
      "bash tests/scripts/ai/run-all-tests.sh": "ask",
      "bats *": "ask",
      "php -v": "allow",
      "php --version": "allow",
      "php tools/ai/validate-ai-config.php": "allow",
      "php tools/ai/validate-ai-catalog.php": "allow",
      "php tools/ai/validate-install-surface.php *": "allow",
      "php tools/ai/validate-generated-artifacts.php": "allow",
      "php tools/ai/generate-ai-catalog.php --check": "allow",
      "php tools/ai/generate-repo-structure.php --check *": "allow",
      "php tools/ai/repo-tool-inventory.php": "allow",
      "php tools/ai/repo-tool-inventory.php --write": "ask",
      "php tools/ai/ai.php preflight": "allow",
      "php tools/ai/ai.php verify *": "allow",
      "php tools/ai/ai.php advisor --check": "allow",
      "php tools/ai/ai.php install-docs --check": "allow",
      "php tools/ai/ai.php placeholders": "allow",
      "php tools/ai/ai.php placeholders --fail": "allow",
      "php vendor/bin/phpunit *": "allow",
      "php vendor/bin/phpunit": "allow",
      "php vendor/bin/paratest *": "allow",
      "composer test": "allow",
      "composer test:fast": "allow",
      "composer test:slow *": "allow",
      "composer test:profile": "allow",
      "composer validate": "allow",
      "shellcheck *": "allow",
      "markdownlint-cli2 *": "allow",
      "shfmt -d *": "allow",
      "actionlint *": "allow",
      "actionlint": "allow",
      "vendor/bin/pint --test *": "allow",
      "./vendor/bin/pint --test *": "allow",
      "vendor/bin/phpstan analyse *": "allow",
      "./vendor/bin/phpstan analyse *": "allow",
      "vendor/bin/php-cs-fixer check *": "allow",
      "./vendor/bin/php-cs-fixer check *": "allow",
      "vendor/bin/php-cs-fixer fix --dry-run *": "allow",
      "./vendor/bin/php-cs-fixer fix --dry-run *": "allow",
      "php tools/ai/verify-full-install.php": "ask",
      "php tools/ai/ai.php install * --dry-run": "ask",
      "rm *": "deny",
      "rm -rf *": "deny",
      "git reset --hard *": "deny",
      "git push --force *": "deny"
    }
  }
}
