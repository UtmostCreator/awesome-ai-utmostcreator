*~
# Merge/patch backups (e.g. from shfmt -w, git rerere, manual merges). Never source.
*.orig
.idea/
.phpunit.result.cache
.phpunit.cache/
.ai-logs/*
!.ai-logs/README.md
.ai-backups/
.repomix-context/
# Generated AI artifacts: regenerated locally by `php tools/ai/ai.php` subcommands.
# Not tracked so each environment produces fresh output and avoids merge conflicts.
# Tests still validate them via regenerate-then-check (see tests/php/CliToolsTest.php).
docs/ai/generated/
# Export bundle output: produced by `php tools/ai/export-ai-universal-rules.php`
# and uploaded as a CI artifact (see export-ai-universal-rules-preview.yml). Not tracked.
/dist/
/composer.phar
# Self-install renders in the kit repo only: docs/ai/package/ duplicates
# packages/ai-universal-rules/docs (the real source), and .ai-tmp/ is the install
# transaction staging dir. Produced by self-install; not source, not committed.
docs/ai/package/
.ai-tmp/
# Draft agent: super-implementer.md is held back pending an id-collision fix
# (its frontmatter id currently duplicates implementer.md). Ignored so it is
# not committed or surfaced as untracked until that is resolved.
.opencode/agents/super-implementer.md

