{
  // Stronger VS Code Copilot defaults. Keep these aligned with
  // .github/hooks/tool-policy.json and docs/ai/script-registry.json.
  "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
  "chat.tools.terminal.blockDetectedFileWrites": "all",
  "chat.tools.terminal.autoApprove": {
    "/^ls\\s+-1\\s+scripts\\/ai\\/\\*\\.sh\\s+\\|\\s+sort$/": true,
    "/^git\\s+status\\s+--short;\\s+echo\\s+\"---BRANCH---\";\\s+git\\s+branch\\s+--show-current$/": true,
    "/^git\\s+status\\s+--short;\\s+git\\s+branch\\s+--show-current$/": true,
    "/^git\\s+status\\s+--short\\s+&&\\s+git\\s+branch\\s+--show-current$/": true,
    "/^\\.\\/vendor\\/bin\\/phpunit(\\s|$)/": true,
    "/^php\\s+(?:artisan|aritsan)\\s+test\\s+--filter(\\s|$)/": true,
    "/^bash scripts\\/ai\\/(ai-search|ai-verify|ai-doc-check|ai-file-freshness|ai-install-coverage|preview-file|fd-files|rg-code|git-forensics|query-usage|ai-diff-context|pack-context|gh-pr-context|repomix-context-tree|repomix-scc-router|check-file-refs|repo-stats)\\.sh(\\s|$)/": true,
    "/<<|>\\s*[^&]|\\$\\(|`|\\bpython3\\b|\\bpython\\b|\\bphp\\s+-r\\b|\\brm\\b|\\bdel\\b|\\brmdir\\b|\\bgit\\s+push\\b|\\bgit\\s+reset\\b|\\bsudo\\b|curl\\s+.*\\|\\s*(sh|bash|zsh|python|python3|php|node|ruby)|wget\\s+.*\\|\\s*(sh|bash|zsh|python|python3|php|node|ruby)/": false
  },
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.networkFilter": true,
  "chat.agent.sandbox.FileSystem.mac": {
    "allowWrite": [
      "."
    ],
    "denyWrite": [
      "./vendor/",
      "./node_modules/",
      "./.env",
      "./.github/workflows/"
    ]
  },
  "chat.agent.sandbox.FileSystem.linux": {
    "allowWrite": [
      "."
    ],
    "denyWrite": [
      "./vendor/",
      "./node_modules/",
      "./.env",
      "./.github/workflows/"
    ]
  },
  "markdownlint.config": {
    "MD007": {
      "indent": 4
    },
    "MD029": {
      "style": "ordered"
    }
  }
}
