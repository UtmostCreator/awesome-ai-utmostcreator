{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": ".github/hooks/scripts/tool-guardian.sh",
        "powershell": ".github/hooks/scripts/tool-guardian.ps1",
        "cwd": ".",
        "env": {
          "GUARD_MODE": "block"
        },
        "timeoutSec": 5
      }
    ]
  }
}
