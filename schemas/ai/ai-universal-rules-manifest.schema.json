{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-configs.local/schemas/ai-universal-rules-manifest.schema.json",
  "title": "AI Universal Rules Manifest",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "version",
    "description",
    "supported_tools",
    "supported_surfaces",
    "workflow_layers",
    "required_templates",
    "runtime_entrypoints",
    "generated_outputs",
    "starter_profiles",
    "release"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "supported_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supported_surfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "workflow_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "starter_optional_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "shared_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preview_only_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "placeholder_reference": {
      "type": "string"
    },
    "generated_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "starter_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "includes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "includes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "release": {
      "type": "object",
      "required": [
        "export_root",
        "bundle_prefix",
        "notes"
      ],
      "properties": {
        "export_root": {
          "type": "string"
        },
        "bundle_prefix": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_bundle_lines": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
