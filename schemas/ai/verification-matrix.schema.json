{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app-configs.local/schemas/verification-matrix.schema.json",
  "title": "Verification Matrix",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "minimum": { "type": "array", "items": { "type": "string" } },
          "broader": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "required": ["path", "minimum", "risk"]
      }
    }
  },
  "required": ["rules"]
}
