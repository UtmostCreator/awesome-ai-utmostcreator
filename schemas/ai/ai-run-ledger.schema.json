{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-configs.local/schemas/ai-run-ledger.schema.json",
  "title": "AI Run Ledger",
  "description": "Per-run rollup record folded from evidence-event.schema.json (v3.0) entries grouped by session_id/trace_id. Every top-level block is optional and every no-source leaf is nullable: populate a field only when the producing runtime (Copilot CLI, OpenCode, Claude Code) has a real data source for it, per docs/ai/schema-ownership.md and the field-source honesty matrix in the owning architecture plan. Never fabricate a value for a field with no source.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": ["string", "null"] },
        "parent_run_id": { "type": ["string", "null"] },
        "trace_id": { "type": ["string", "null"] },
        "session_id": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "tool": { "type": ["string", "null"] },
        "surface": { "type": ["string", "null"] },
        "agent": { "type": ["string", "null"] },
        "workflow": { "type": ["string", "null"] },
        "task_type": { "type": ["string", "null"] },
        "task_risk": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
        "repo": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "base_ref": { "type": ["string", "null"] },
        "head_sha_before": { "type": ["string", "null"] },
        "head_sha_after": { "type": ["string", "null"] },
        "worktree_clean_before": { "type": ["boolean", "null"] },
        "worktree_clean_after": { "type": ["boolean", "null"] },
        "run_close": {
          "type": ["string", "null"],
          "enum": ["deterministic", "inferred", "plugin_marker", "unknown", null],
          "description": "How the run boundary was closed. Claude Stop/SessionEnd = deterministic. OpenCode audit-plugin session.idle/session.error marker = plugin_marker. Copilot has no run-end hook: last-event-per-session heuristic = inferred. Never label a runtime's close as deterministic without a proven hook invocation (docs/ai/security.md invariant 6)."
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_model": { "type": ["string", "null"] },
        "actual_models": { "type": "array", "items": { "type": "string" } },
        "model_switches": { "type": "array", "items": { "type": "object" } },
        "reasoning_mode": { "type": ["string", "null"] },
        "temperature": { "type": ["number", "null"] }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": ["string", "null"] },
        "ai_credits_total": { "type": ["number", "null"], "minimum": 0 },
        "estimated_usd": { "type": ["number", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_by_model": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": { "type": ["string", "null"] },
              "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "ai_credits": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },
        "cost_per_changed_file": { "type": ["number", "null"], "minimum": 0 },
        "cost_per_accepted_change": { "type": ["number", "null"], "minimum": 0 },
        "cost_per_verified_test": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": ["string", "null"] },
        "context_window_tokens_used": { "type": ["integer", "null"], "minimum": 0 },
        "context_window_tokens_total": { "type": ["integer", "null"], "minimum": 0 },
        "context_window_used_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "system_prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "custom_instruction_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "system_tool_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "mcp_tool_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "message_history_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "free_space_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "buffer_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "compaction_happened": { "type": ["boolean", "null"] },
        "manual_compaction_happened": { "type": ["boolean", "null"] },
        "context_warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_file": { "type": ["string", "null"] },
        "instruction_files_expected": { "type": "array", "items": { "type": "string" } },
        "instruction_files_observed_loaded": { "type": "array", "items": { "type": "string" } },
        "missing_instruction_files": { "type": "array", "items": { "type": "string" } },
        "scope_contract_present": { "type": ["boolean", "null"] },
        "scope_contract_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "instruction_adherence_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "violated_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rule": { "type": ["string", "null"] },
              "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
              "evidence": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_index": { "type": ["integer", "null"], "minimum": 0 },
          "timestamp": { "type": ["string", "null"], "format": "date-time" },
          "user_intent": { "type": ["string", "null"] },
          "prompt_hash": { "type": ["string", "null"] },
          "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "response_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "ai_credits": { "type": ["number", "null"], "minimum": 0 },
          "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
          "files_attached": { "type": "array", "items": { "type": "string" } },
          "tools_used": { "type": "array", "items": { "type": "string" } },
          "outcome": { "type": ["string", "null"] }
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "description": "Real, fully-sourced across all runtimes: folded directly from evidence-event.schema.json entries in .ai-logs/tool-usage.jsonl for this run's session_id/trace_id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "call_id": { "type": ["string", "null"] },
          "turn_index": { "type": ["integer", "null"], "minimum": 0 },
          "tool_name": { "type": ["string", "null"] },
          "command": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
          "exit_code": { "type": ["integer", "null"] },
          "stdout_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "stderr_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "output_truncated": { "type": ["boolean", "null"] },
          "risk": { "type": ["string", "null"] },
          "authorization_decision": { "type": ["string", "null"], "enum": ["allowed", "denied", "ask", "unknown", null] },
          "error_class": { "type": ["string", "null"] }
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "description": "Real source, but never inline: full diffs/patches are referenced by artifact path + sha256, never embedded (see Things To Avoid: no inline prompts/diffs/secrets).",
      "properties": {
        "files_changed": { "type": ["integer", "null"], "minimum": 0 },
        "lines_added": { "type": ["integer", "null"], "minimum": 0 },
        "lines_removed": { "type": ["integer", "null"], "minimum": 0 },
        "net_lines": { "type": ["integer", "null"] },
        "artifact_path": { "type": ["string", "null"] },
        "artifact_sha256": { "type": ["string", "null"] },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] },
              "lines_added": { "type": ["integer", "null"], "minimum": 0 },
              "lines_removed": { "type": ["integer", "null"], "minimum": 0 },
              "in_scope": { "type": ["boolean", "null"] },
              "risk": { "type": ["string", "null"] }
            }
          }
        },
        "unexpected_files_changed": { "type": "array", "items": { "type": "string" } },
        "scope_violations": { "type": ["integer", "null"], "minimum": 0 },
        "generated_code_percent_estimate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "complexity_delta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cyclomatic_before": { "type": ["number", "null"] },
            "cyclomatic_after": { "type": ["number", "null"] },
            "delta": { "type": ["number", "null"] }
          }
        },
        "security_sensitive_changes": { "type": ["boolean", "null"] },
        "config_changes": { "type": ["boolean", "null"] },
        "dependency_changes": { "type": ["boolean", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_run": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": ["string", "null"] },
              "passed": { "type": ["boolean", "null"] },
              "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
              "failure_summary": { "type": ["string", "null"] }
            }
          }
        },
        "lint_run": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": ["string", "null"] },
              "passed": { "type": ["boolean", "null"] }
            }
          }
        },
        "static_analysis_run": { "type": "array", "items": { "type": "object" } },
        "typecheck_run": { "type": "array", "items": { "type": "object" } },
        "security_scan_run": { "type": "array", "items": { "type": "object" } },
        "verification_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "known_unverified_risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": { "type": ["boolean", "null"] },
        "merged": { "type": ["boolean", "null"] },
        "review_required": { "type": ["boolean", "null"] },
        "reviewer_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "maintainer_rework_minutes": { "type": ["number", "null"], "minimum": 0 },
        "human_rework_reason": { "type": ["string", "null"] },
        "first_pass_success": { "type": ["boolean", "null"] },
        "rollback_required": { "type": ["boolean", "null"] },
        "bug_introduced": { "type": ["boolean", "null"] },
        "regression_found_later": { "type": ["boolean", "null"] }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "description": "No current data source on any runtime; leaves stay null until an eval producer exists (v0.6 Phase 8 rules-eval harness is decision-only today).",
      "properties": {
        "overall_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "cost_efficiency_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "correctness_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "scope_discipline_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "instruction_adherence_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "tool_discipline_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "context_efficiency_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "final_grade": { "type": ["string", "null"] }
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "description": "Partial source: derived from evidence-event.schema.json failure.category classification (post-tool-use.sh) where present.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": { "type": ["string", "null"] },
          "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
          "root_cause": { "type": ["string", "null"] },
          "instruction_fix": { "type": ["string", "null"] }
        }
      }
    },
    "improvement_actions": {
      "type": "array",
      "description": "No current data source on any runtime; stays empty/absent until a producer exists.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": { "type": ["string", "null"] },
          "change_type": { "type": ["string", "null"] },
          "priority": { "type": ["string", "null"] },
          "recommendation": { "type": ["string", "null"] }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Real source: backed by the existing redaction seam (scripts/ai/internal/lib/31-log-redaction.sh, 10-json.sh).",
      "properties": {
        "raw_prompts_stored": { "type": ["boolean", "null"] },
        "prompt_hashing": { "type": ["string", "null"] },
        "redaction_applied": { "type": ["boolean", "null"] },
        "secrets_detected": { "type": ["boolean", "null"] },
        "paths_are_stored": { "type": ["boolean", "null"] }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
