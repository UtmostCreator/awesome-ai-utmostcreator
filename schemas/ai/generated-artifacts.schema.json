{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated Artifacts Policy",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "generate": { "type": "string" },
          "check": { "type": "string" },
          "committed": { "type": "boolean" }
        },
        "required": ["path", "generate"]
      }
    }
  },
  "required": ["artifacts"]
}
