{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-configs.local/schemas/evidence-event.schema.json",
  "title": "AI Agent Evidence Event",
  "type": "object",
  "required": [
    "event_version",
    "event_type",
    "trace_id",
    "session_id",
    "task_id",
    "timestamp",
    "actor",
    "tool",
    "authorization",
    "execution"
  ],
  "properties": {
    "event_version": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "span_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_span_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "debug",
        "info",
        "warn",
        "error",
        null
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "delegated_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "mutates_state"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "args_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutates_state": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "decision"
      ],
      "properties": {
        "policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "allowed",
            "denied",
            "ask",
            "unknown"
          ]
        },
        "approval_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "error",
            "timeout",
            "blocked",
            "unknown"
          ]
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retry_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_truncated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "preview": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
