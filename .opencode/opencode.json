{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/ai/tools/ai-search.md",
    "docs/ai/tools/tool-map.md",
    "docs/ai/tools/actions/search-evidence.md",
    "docs/ai/tools/actions/preview-file.md"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.crt": "deny"
    },
    "edit": {
      "*": "ask",
      ".opencode/**": "deny",
      ".github/agents/**": "deny",
      ".github/instructions/**": "deny",
      ".github/prompts/**": "deny",
      ".github/prompts-optional/**": "deny",
      ".github/skills/**": "deny",
      ".github/workflows/**": "deny",
      ".github/copilot-instructions.md": "deny",
      ".github/pull_request_template.md": "deny",
      "docs/ai/generated/**": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.crt": "deny"
    },
    "grep": { "*": "ask" },
    "glob": { "*": "ask" },
    "list": { "*": "ask" },
      "bash": {
        "*": "ask",
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "bash scripts/ai/ai-search.sh *": "allow",
        "AI_OUTPUT=json bash scripts/ai/ai-search.sh *": "allow",
        "env AI_OUTPUT=json bash scripts/ai/ai-search.sh *": "allow",
        "bash scripts/ai/preview-file.sh *": "allow",
        "AI_OUTPUT=json bash scripts/ai/preview-file.sh *": "allow",
        "env AI_OUTPUT=json bash scripts/ai/preview-file.sh *": "allow",
        "bash scripts/ai/query-usage.sh *": "allow",
        "bash scripts/ai/ai-diff-context.sh *": "allow",
        "bash scripts/ai/git-forensics.sh *": "allow",
        "bash scripts/ai/ai-doc-check.sh *": "allow",
        "bash scripts/ai/ai-test-select.sh *": "allow",
        "bash scripts/ai/ai-task.sh *": "allow",
        "bash scripts/ai/ai-structured.sh *": "allow",
        "bash scripts/ai/ai-verify.sh *": "ask",
        "bash scripts/ai/pack-context.sh *": "ask",
        "bash scripts/ai/run-repomix-context.sh *": "ask",
        "bash scripts/ai/repomix-context-tree.sh *": "ask",
        "bash scripts/ai/repomix-scc-router.sh *": "ask",
        "bash scripts/ai/ai-edit.sh *": "ask",
        "bash scripts/ai/ai-rollback.sh *": "ask",
        "bash scripts/ai/install-mandatory-tools.sh *": "ask",
        "bash scripts/*.sh *": "ask",
        "bash tools/ai/*.sh *": "ask",
        "vendor/bin/phpunit *": "ask",
        "./vendor/bin/phpunit *": "ask",
        "vendor/bin/pest *": "ask",
        "./vendor/bin/pest *": "ask",
        "vendor/bin/pint *": "ask",
        "./vendor/bin/pint *": "ask",
        "php tools/ai/ai.php install * --dry-run": "allow",
        "php tools/ai/ai.php install * --apply": "allow",
        "php tools/ai/install-ai-kit.php *": "allow",
        "php tools/ai/validate-install-surface.php": "allow",
        "php tools/ai/verify-full-install.php": "allow",
        "php tools/ai/ai.php advisor --all": "allow",
        "grep *": "ask",
        "rg *": "ask",
        "find *": "ask",
        "fd *": "ask",
        "cat *": "ask",
        "sed *": "ask",
        "awk *": "ask",
        "rm *": "deny",
        "chown *": "deny",
        "sudo *": "deny",
        "git push*": "deny",
        "mv *": "ask",
        "cp *": "ask",
        "chmod *": "ask",
        "git reset*": "ask",
        "git clean*": "ask"
      },
    "skill": {
      "*": "ask",
      "ai-search": "allow",
      "ai-verification": "allow",
      "ai-context": "allow"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
