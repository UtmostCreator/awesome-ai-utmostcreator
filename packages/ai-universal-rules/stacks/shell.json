{
  "schema_version": 1,
  "id": "shell",
  "label": "Shell",
  "description": "Shell scripts and command-line automation",
  "category": "tooling",
  "detection": {
    "files": [".shellcheckrc"],
    "globs": ["*.sh", "scripts/**/*.sh"],
    "commands": [],
    "scc_languages": ["Shell"],
    "confidence": { "*.sh": 45, "scripts/**/*.sh": 70, ".shellcheckrc": 75, "scc:Shell": 60 }
  },
  "version_checks": [
    { "id": "bash", "tool": "bash", "args": ["--version"], "required": false },
    { "id": "shellcheck", "tool": "shellcheck", "args": ["--version"], "required": false }
  ],
  "permission_overlays": { "language_overlays": ["shell"], "extra_layers": [] },
  "project_context": { "primaryLanguage": "Shell", "primaryRuntime": "bash", "primaryVerifyCommand": "shellcheck <changed-files>" },
  "recommended_commands": { "lint": "shellcheck <changed-files>" },
  "package_managers": [],
  "conflicts": [],
  "implies": [],
  "merge_priority": 30
}
