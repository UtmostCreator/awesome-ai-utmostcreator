{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/utmostcreator/app-configs/docs/ai/script-registry.schema.json",
  "title": "AI Script Registry",
  "description": "Schema for docs/ai/script-registry.json. Each registered script declares its identity, risk class, approval surface, dry-run support, and verification expectations.",
  "type": "object",
  "required": ["schema_version", "scripts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semantic version of the registry contract."
    },
    "scripts": {
      "description": "Script entries keyed by stable script id.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/script" }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "required": ["source_path", "installed_path", "risk", "autonomy_level"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier used by routers and policies."
        },
        "source_path": {
          "type": "string",
          "description": "Repo-relative source script path."
        },
        "installed_path": {
          "type": "string",
          "description": "Repo-relative installed script path."
        },
        "path": {
          "type": "string",
          "description": "Legacy repo-relative script path. Prefer installed_path."
        },
        "description": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "enum": ["read-only", "mutating", "low", "medium", "high"],
          "description": "Risk class controlling approval boundary."
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["observe", "advise", "act_with_approval", "act_autonomously"],
          "description": "Maximum default autonomy level for the script. See docs/ai/capabilities/authorization-and-tool-governance/CAPABILITY.md."
        },
        "mutates_state": {
          "type": "boolean"
        },
        "requires_approval": {
          "type": "boolean"
        },
        "approval": {
          "type": "string",
          "enum": ["allow", "ask", "deny"],
          "description": "Default policy decision for invocation."
        },
        "supports_dry_run": {
          "type": "boolean"
        },
        "evidence": {
          "type": "object",
          "description": "Where structured evidence is written when the script runs.",
          "properties": {
            "log_path": { "type": "string" },
            "schema": { "type": "string" }
          }
        },
        "verification": {
          "type": "object",
          "description": "Recommended verification step after invocation.",
          "properties": {
            "command": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
